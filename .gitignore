# ── Data (large / regenerable) ────────────────────────────────────────────────
loan_default.csv
loan_default_sample*.csv
data/*.csv
*.parquet

# ── Text-analyst outputs (large; regenerable from text_analyst.py) ────────────
# Ignore everything under text_ana_results/ EXCEPT the consolidated 21000-borrower
# pkl we publish. The bare-directory form `text_ana_results/` would block negations
# below it; using `text_ana_results/*` keeps the exception working.
text_ana_results/*
!text_ana_results/text_analysis_combined.pkl

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Text analyst driver (kept local; contains user-specific API key) ──────────
text_analyst.py

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── LaTeX intermediates ───────────────────────────────────────────────────────
*.aux
*.log
*.out
*.toc
